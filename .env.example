# Configuración de Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediflow
DB_USER=mediflow_user
DB_PASSWORD=tu_password_local
SERVER_PORT=8080

GEMINI_API_KEY=
GEMINI_MODEL=
AUDIT_CONFIDENCE_THRESHOLD=0.85
AI_CORE_PORT=8000

# Configuración de OCI Object Storage
OCI_BUCKET_NAME=mediflow-documentos-clinicos
OCI_NAMESPACE=tu_namespace_aqui
OCI_REGION=us-ashburn-1
OCI_AUTH_MODE=config_file

# Backend en Docker
BACKEND_PORT=8080
# Solo desarrollo local fuera de OCI; ver backend/README.md. En OCI dejar en false.
BACKEND_LAZY_INIT=true
