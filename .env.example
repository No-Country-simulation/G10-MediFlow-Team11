# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediflow
DB_USER=mediflow_user
DB_PASSWORD=
SERVER_PORT=8080

# AI Core
GEMINI_API_KEY=
GEMINI_MODEL=
AUDIT_CONFIDENCE_THRESHOLD=0.85
AI_CORE_PORT=8000
MEDIFLOW_AI_SERVICE_URL=http://localhost:8000

# OCI Object Storage
OCI_BUCKET_NAME=mediflow-documentos-clinicos
OCI_NAMESPACE=
OCI_REGION=us-ashburn-1
OCI_AUTH_MODE=config_file

# Backend Docker
BACKEND_PORT=8080
# Solo desarrollo local fuera de OCI; ver backend/README.md. En OCI dejar en false.
BACKEND_LAZY_INIT=true
